{
  "name": "elevate-mind-app",
  "version": "2.0.0",
  "description": "ElevateMind — A holistic career and mental wellness portal",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint src/ server.js --ext .js",
    "lint:fix": "eslint src/ server.js --ext .js --fix",
    "test": "echo \"Tests coming soon\" && exit 0"
  },
  "keywords": [
    "career",
    "wellness",
    "mental-health",
    "express",
    "sqlite"
  ],
  "author": "Devlalit1",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.28.0",
    "nodemon": "^3.1.10"
  },
  "nodemonConfig": {
    "watch": [
      "src/",
      "server.js"
    ],
    "ext": "js,json",
    "ignore": [
      "node_modules/",
      "data/",
      "logs/"
    ]
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
